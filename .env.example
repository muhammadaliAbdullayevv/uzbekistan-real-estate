DATABASE_URL="postgresql://db_user:db_password@localhost:5432/rentalwebapp?schema=public"
SITE_URL="http://localhost:3000"
PUBLIC_CONTACT_EMAIL="hello@example.com"
OWNER_EMAIL="owner@example.com"
# Optional: move the owner dashboard off the guessable default /admin path,
# e.g. "/manage-x7k2". Leave unset to keep it at /admin.
ADMIN_PATH=""
# Google Sign-In (optional): leave blank to hide the "Continue with Google" button
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Telegram phone verification (optional): leave blank to hide the "Verify via Telegram" button.
# 1. Message @BotFather on Telegram, run /newbot, and follow the prompts to get a token + username.
# 2. Put the token here for the bot process (run separately: `npm run telegram-bot`).
# 3. Put the bot's @username (without the @) here so the website can build the t.me deep link.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# AI Uychi (optional): leave blank to hide the AI Uychi nav tab entirely.
# Free key from https://aistudio.google.com/apikey (Google AI Studio).
GEMINI_API_KEY=""
# Optional: override the default model (gemini-flash-latest).
GEMINI_MODEL=""
# Optional: comma-separated fallback models tried in order if the primary
# model is rate-limited or unavailable (default: gemini-flash-latest,
# gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,
# gemini-3.1-flash-lite). Check your AI Studio dashboard for what's actually
# available/free on your account.
GEMINI_MODEL_FALLBACKS=""
# Listing location picker's satellite map (optional): leave blank to fall
# back to Esri's free World Imagery tiles. Free account at mapbox.com --
# Mapbox's free tier (50k map loads/month) has no non-commercial-use
# restriction, unlike similar free tiers from MapTiler/Stadia Maps, and its
# Satellite Streets style shows real building-level labels Esri's free
# tiles don't have for Uzbekistan. This is a public/client-embeddable
# token by design (Mapbox's own model), hence NEXT_PUBLIC_.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
# Recommended free cloud image storage for this project: Supabase Storage
SUPABASE_URL=""
# Supabase has renamed this key over time; SUPABASE_SERVICE_ROLE_KEY also
# works as a fallback if that's the name shown in your Supabase dashboard.
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="listing-images"
# Optional alternative cloud image storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="uzbekistan-rentals/listings"
# Set to "true" only when deploying to a host with persistent local disk
# (e.g. a VPS) and you don't want to use Supabase/Cloudinary at all.
# Leave unset on ephemeral hosts (Render, etc.) — uploaded files would be lost on redeploy.
ALLOW_LOCAL_UPLOADS=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM="Uzbekistan Rentals <no-reply@example.com>"
